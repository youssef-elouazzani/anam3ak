rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /pros/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    match /requests/{rid} {
      allow read: if true;
      allow create: if true;

      allow update: if signedIn() && (
        (resource.data.status == "open" &&
         request.resource.data.status == "accepted" &&
         request.resource.data.acceptedBy == request.auth.uid) ||

        (resource.data.status == "accepted" &&
         resource.data.acceptedBy == request.auth.uid &&
         request.resource.data.status == "done") ||

        (resource.data.status == "done" &&
         resource.data.ratedAt == null &&
         request.resource.data.ratingToken == resource.data.ratingToken)
      );

      allow delete: if false;
    }
  }
}
